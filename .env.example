APP_ENV=local
LOCAL_IDENTITY=true
DATABASE_URL=postgresql+psycopg://worktracker:local_only@127.0.0.1:55432/worktracker
# Optional SQLite fallback: sqlite:///./.local/worktracker.db
# Required for beta/production (local identity MUST be false):
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=

# Browser sign-in uses a confidential Keycloak client (never set these in VITE_*).
# For local setup use scripts/dev-auth-api.ps1; it reads ignored .local/auth/config.json.
WORKROOM_ORIGIN=http://127.0.0.1:5173
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Production requires HTTPS app/issuer/JWKS, LOCAL_IDENTITY=false and PostgreSQL.
# Optional server-only AI registry. Run scripts/configure_ai.py first.
# dev-auth-api.ps1 automatically selects this file when present.
# WORKROOM_AI_CONFIG=D:/myprojects/Alt-Brain.ai/.local/ai/config.json
# The local real-auth launcher reads these AI variables from the ignored root .env.
# Keys are server-only. Never use VITE_* names. Blank values preserve JSON/key-file settings.
WORKROOM_AI_DEFAULT_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
MISTRAL_API_KEY=
MISTRAL_MODEL=
MISTRAL_INPUT_USD_PER_MILLION=
MISTRAL_OUTPUT_USD_PER_MILLION=
GROK_API_KEY=
GROK_MODEL=
GROK_INPUT_USD_PER_MILLION=
GROK_OUTPUT_USD_PER_MILLION=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_UPSTREAM=
OPENROUTER_INPUT_USD_PER_MILLION=
OPENROUTER_OUTPUT_USD_PER_MILLION=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_INPUT_USD_PER_MILLION=
DEEPSEEK_OUTPUT_USD_PER_MILLION=
